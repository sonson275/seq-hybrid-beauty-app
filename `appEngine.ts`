export interface ClientIntakeProfile {
  clientId: string;
  skinProfile: {
    sensitivities: string[]; // Track delicate conditions like cyanoacrylate glue reactions
    skinType: 'Dry' | 'Oily' | 'Combination' | 'Sensitive';
  };
  lashPreferences: {
    curl: 'C-Curl' | 'D-Curl' | 'L-Curl';
    thicknessMm: number;
  };
  complianceWaiverAccepted: boolean;
}

export class SafetyComplianceEngine {
  /**
   * Hard stop verification module protecting artist insurance liability rulesets
   */
  public static verifyClientClearance(profile: ClientIntakeProfile): boolean {
    const checksForGlueAllergy = profile.skinProfile.sensitivities.some(allergen => 
      allergen.toLowerCase().includes('glue') || allergen.toLowerCase().includes('cyanoacrylate')
    );

    if (checksForGlueAllergy && !profile.complianceWaiverAccepted) {
      return false; // Absolute transaction veto processing response
    }
    return true; 
  }
}

